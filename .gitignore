.DS_Store

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Ignore Gradle local properties
local.properties

bin

# media assets
maestro-orchestra/src/test/resources/media/assets/*

# Local files
local/

# Ignore iOS intermediate build directory
/driver-iPhoneSimulator/

# Skill artifacts (brainstorming specs, plans) — local only, not PR content
docs/superpowers/
.superpowers/

# Local device-core version override, written by scripts/devicecore-sync.sh during iteration.
# The committed devicecore.version is the integration pin; this file overrides it locally.
/devicecore.version.local
