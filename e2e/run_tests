#!/usr/bin/env sh
set -eu

# Runs all tests in demo_app/.maestro and the workspaces directory.
#
# Honors two optional env vars set by the workflow's validate-inputs job:
#   MAESTRO_APP        - restrict to a single workspace (e.g. demo_app)
#   MAESTRO_FLOW_PATH  - run only one resolved flow yaml (single-flow mode)

command -v maestro >/dev/null 2>&1 || { echo "maestro is required" && exit 1; }

[ "$(basename "$PWD")" = "e2e" ] || { echo "must be run from e2e directory" && exit 1; }

ALL_PASS=true

_h1() { printf "=>\n=> %s\n=>\n" "$1"; }
_h2() { printf "==> [%s] %s\n" "$1" "$2"; }
_h3() { printf "==> [%s] [%s] => %s\n" "$1" "$2" "$3"; }

cloud="android_device_configuration,ios_device_configuration" # Maestro Cloud specific tests
platform="${1:-}"
case "$platform" in
	android) exclude_tags="ios,web,$cloud" ;;
	ios)     exclude_tags="android,$cloud,web" ;;
	web)     exclude_tags="android,ios,$cloud" ;;
	*)       echo "usage: $0 <android|ios|web>"; exit 1 ;;
esac

app_filter="${MAESTRO_APP:-}"
flow_path="${MAESTRO_FLOW_PATH:-}"

# Everything the suite knows about each workspace — where its flows are, which platforms it
# runs on, whether it carries failing-tagged flows — lives in workspaces.txt, so adding or
# retiring one is a data change rather than an edit to the branches below.
manifest="workspaces.txt"
[ -f "$manifest" ] || { echo "$manifest not found" && exit 1; }

# A positional data file fails quietly when it is edited wrongly: a space where a comma belongs
# shifts every column right, and a misspelt platform simply matches nothing — either way a
# workspace stops being tested and says nothing about it. Check the shape up front instead, and
# name the line.
_validate_manifest() {
	awk '
		NF == 0     { next }
		$1 ~ /^#/   { next }
		{
			rows++
			if (NF != 4) {
				printf "%s:%d: expected 4 fields (name path platforms failing), found %d: %s\n", FILENAME, FNR, NF, $0
				bad = 1
				next
			}
			if (seen[$1]++) {
				printf "%s:%d: duplicate workspace: %s\n", FILENAME, FNR, $1
				bad = 1
			}
			count = split($3, platforms, ",")
			for (i = 1; i <= count; i++) {
				if (platforms[i] != "android" && platforms[i] != "ios" && platforms[i] != "web") {
					printf "%s:%d: unknown platform \"%s\" in \"%s\" (want android, ios or web, comma-separated)\n", FILENAME, FNR, platforms[i], $3
					bad = 1
				}
			}
			if ($4 != "yes" && $4 != "no") {
				printf "%s:%d: failing must be yes or no, found \"%s\"\n", FILENAME, FNR, $4
				bad = 1
			}
		}
		END {
			if (rows == 0) { printf "%s: no workspaces listed\n", FILENAME; bad = 1 }
			exit bad
		}
	' "$manifest" || return 1

	# Checked here rather than in awk, which cannot see the filesystem.
	bad_path=""
	while read -r name path _rest; do
		case "$name" in '#'*|'') continue ;; esac
		[ -d "$path" ] || { echo "$manifest: $name: flow directory not found: $path"; bad_path=1; }
	done < "$manifest"
	[ -z "$bad_path" ]
}

_validate_manifest || { echo "$manifest is not valid; fix the lines above" && exit 1; }

# Takes the platform list itself, so the caller can see what is being matched.
_supports_platform() {
	case ",$1," in
		*",$2,"*) return 0 ;;
		*)        return 1 ;;
	esac
}

mkfifo pipe
trap 'rm -f pipe' EXIT

export MAESTRO_EXAMPLE="test-value"  # Relied upon in a test

_run_passing() {
	app_name="$1"
	workspace_target="$2"

	_h2 "$app_name" "run passing tests"

	while IFS= read -r line; do
		_h3 "$app_name" "passing" "$line"
	done < pipe &

	maestro --verbose --no-ansi --platform "$platform" test --flatten-debug-output --debug-output="$HOME/.maestro/tests/${app_name}/passing" --include-tags passing --exclude-tags "$exclude_tags" "$workspace_target" 1>pipe 2>&1 \
		|| { _h2 "$app_name" "FAIL! Expected all pass, but at least some failed instead"; ALL_PASS=false; }
}

_run_failing() {
	app_name="$1"
	workspace_target="$2"

	_h2 "$app_name" "run failing tests"

	while IFS= read -r line; do
		_h3 "$app_name" "failing" "$line"
	done < pipe &

	# Inverted polarity: maestro is EXPECTED to exit non-zero. We use `if maestro …` so that
	# (a) set -e doesn't abort the script when maestro correctly fails, and
	# (b) we record FAIL only when maestro succeeds (i.e. failing flows unexpectedly passed).
	if maestro --verbose --no-ansi --platform "$platform" test --flatten-debug-output --debug-output="$HOME/.maestro/tests/${app_name}/failing" --include-tags failing --exclude-tags "$exclude_tags" "$workspace_target" 1>pipe 2>&1; then
		_h2 "$app_name" "FAIL! Expected all to fail, but at least some passed instead"
		ALL_PASS=false
	fi
}

_run_single_flow() {
	app_name="$1"
	target_yaml="$2"

	_h1 "run single flow \"$target_yaml\" for app \"$app_name\" on platform \"$platform\""
	_h2 "$app_name" "run single flow"

	while IFS= read -r line; do
		_h3 "$app_name" "flow" "$line"
	done < pipe &

	maestro --verbose --no-ansi --platform "$platform" test --flatten-debug-output --debug-output="$HOME/.maestro/tests/${app_name}/flow" "$target_yaml" 1>pipe 2>&1 \
		|| { _h2 "$app_name" "FAIL! Single-flow run failed"; ALL_PASS=false; }
}

if [ -n "$flow_path" ]; then
	###
	### Single-flow mode: run exactly one yaml, no tag filtering.
	###
	app_name="${app_filter:-demo_app}"
	_run_single_flow "$app_name" "$flow_path"
elif [ "$platform" = "web" ]; then
	###
	### Web: run web-tagged tests for demo_app only
	###
	workspace_dir="./demo_app/.maestro"
	app_name="demo_app"

	_h1 "run tests for app \"$app_name\" on platform \"$platform\""
	_h2 "$app_name" "run web tests"

	while IFS= read -r line; do
		_h3 "$app_name" "web" "$line"
	done < pipe &

	maestro --verbose --no-ansi --platform "$platform" test --flatten-debug-output --debug-output="$HOME/.maestro/tests/${app_name}/web" --headless --include-tags web --exclude-tags "$exclude_tags" "$workspace_dir" 1>pipe 2>&1 \
		|| { _h2 "$app_name" "FAIL! Expected all pass, but at least some failed instead"; ALL_PASS=false; }
else
	###
	### Every workspace the manifest lists, or just the one MAESTRO_APP names.
	###
	# Read from the file rather than a pipeline, so the loop body stays in this shell and can
	# still set ALL_PASS.
	matched=""

	while read -r app_name workspace_path platforms failing; do
		case "$app_name" in '#'*|'') continue ;; esac

		if [ -n "$app_filter" ] && [ "$app_name" != "$app_filter" ]; then
			continue
		fi
		matched=1

		if ! _supports_platform "$platforms" "$platform"; then
			# Worth saying when it is the workspace that was asked for; noise otherwise.
			if [ -n "$app_filter" ]; then
				echo "skipping $app_name on $platform"
			fi
			continue
		fi

		workspace_dir="./$workspace_path"

		_h1 "run tests for app \"$app_name\" on platform \"$platform\""
		_run_passing "$app_name" "$workspace_dir"

		if [ "$failing" = "yes" ]; then
			_run_failing "$app_name" "$workspace_dir"
		fi
	done < "$manifest"

	if [ -n "$app_filter" ] && [ -z "$matched" ]; then
		echo "unknown workspace: $app_filter (not listed in $manifest)"
		exit 1
	fi
fi

if [ "$ALL_PASS" = "false" ]; then
	_h1 "FAILURE: some tests failed!"
	exit 1
else
	_h1 "SUCCESS: all tests passed!"
fi
